# Supabase — copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Platform base URL — set to your Vercel deployment domain.
# Used to construct QR/NFC permanent URLs: <VITE_PLATFORM_URL>/c/<token>
VITE_PLATFORM_URL=https://your-vercel-domain.vercel.app
